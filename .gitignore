# Auto detect text files and normalize line endings to LF in the repo
* text=auto eol=lf

# ---- Source code: always treat as text, normalize line endings ----
*.c   text diff=cpp
*.h   text diff=cpp
*.md  text
*.txt text
*.ps1 text eol=crlf

# ---- Config / misc text files ----
.gitattributes text export-ignore
.gitignore     text export-ignore
LICENSE        text
README.md      text

# ---- Binary files: never touch line endings, no text diff ----
*.exe  binary
*.dll  binary
*.so   binary
*.dylib binary
*.lib  binary
*.a    binary
*.o    binary
*.obj  binary
*.pdb  binary
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary

# ---- Linguist hints (GitHub language stats) ----
*.c linguist-language=C
*.h linguist-language=C